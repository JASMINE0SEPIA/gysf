{
  "schemaVersion": 1,
  "id": "gysf",
  "provides": ["caustica"],
  "version": "${version}",
  "name": "gysf",
  "icon": "assets/caustica/icon-gysf.png",
  "description": "Hardware-ray-traced renderer with DLSS Ray Reconstruction for the Minecraft Vulkan backend.",
  "authors": [
    "ComfyFluffy",
    "JASMINE0SEPIA"
  ],
  "contact": {
    "sources": "https://github.com/JASMINE0SEPIA/gysf",
    "issues": "https://github.com/JASMINE0SEPIA/gysf/issues"
  },
  "license": "LGPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.comfyfluffy.caustica.CausticaMod"
    ],
    "client": [
      "dev.comfyfluffy.caustica.client.CausticaClient"
    ],
    "sodium:config_api_user": [
      "dev.comfyfluffy.caustica.compat.sodium.GysfSodiumOptions"
    ]
  },
  "mixins": [
    "caustica.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
